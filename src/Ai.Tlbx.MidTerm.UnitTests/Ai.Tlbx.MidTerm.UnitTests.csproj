<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Tests call APIs in the self-contained server and build host executables. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ai.Tlbx.MidTerm\Ai.Tlbx.MidTerm.csproj" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.TtyHost\Ai.Tlbx.MidTerm.TtyHost.csproj" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.AgentHost\Ai.Tlbx.MidTerm.AgentHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.FakeClaude\Ai.Tlbx.MidTerm.FakeClaude.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.FakeCodex\Ai.Tlbx.MidTerm.FakeCodex.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AppServerControlHostProtocolTests.cs" />
    <Compile Remove="AppServerControlHostTestClient.cs" />
    <Compile Remove="MtAgentHostCodexIntegrationTests.cs" />
    <Compile Remove="MtAgentHostClaudeIntegrationTests.cs" />
    <Compile Remove="MtAgentHostGrokIntegrationTests.cs" />
    <Compile Remove="MtAgentHostIntegrationTests.cs" />
    <Compile Remove="MtAgentHostRealCodexSmokeTests.cs" />
    <Compile Remove="MtAgentHostRealClaudeSmokeTests.cs" />
    <Compile Remove="MtAgentHostRealAcpSmokeTests.cs" />
    <Compile Remove="MtAgentHostRealResumeCatalogSmokeTests.cs" />
    <Compile Remove="SessionAppServerControlHistoryServiceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="WindowsProcessMonitorTests.cs" />
  </ItemGroup>
</Project>
